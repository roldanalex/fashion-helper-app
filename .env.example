# Supabase — project settings → API
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key

# OpenAI — platform.openai.com (set a monthly budget cap!)
OPENAI_API_KEY=sk-...
# Optional: model for the Stylist chat (default gpt-5.5; gpt-5.4-mini is the cheaper fallback)
# STYLIST_MODEL=gpt-5.5

# OpenWeatherMap — openweathermap.org/api (free tier)
OPENWEATHER_API_KEY=your-key
